# Market data provider: "auto" (try Yahoo, fall back to simulator), "yahoo" or "simulated"
STOCKPULSE_PROVIDER=auto
# Seconds between live quote refreshes for tracked symbols
STOCKPULSE_QUOTE_INTERVAL_SECONDS=5
# Minutes a trained prediction stays cached
STOCKPULSE_PREDICTION_TTL_MINUTES=15
# Comma-separated list of allowed browser origins
STOCKPULSE_CORS_ORIGINS=http://localhost:5173
STOCKPULSE_LOG_LEVEL=INFO
