# Port the web app listens on
PORT=3100
# Folder for the SQLite database file (back this folder up)
DATA_DIR=./data
# Time zone that decides what "today" is for daily tasks
APP_TZ=Asia/Kolkata
# Working days, 1 = Monday ... 7 = Sunday. Carried tasks skip other days.
WORK_DAYS=1,2,3,4,5,6
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Days a login stays valid
SESSION_DAYS=14
