{
  "name": "team-tracker",
  "version": "1.0.0",
  "description": "Team workflow tracker: projects (deadlines, people, parts, status, revisions) and daily to-do lists with done / carry forward.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  }
}
