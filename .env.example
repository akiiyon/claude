# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Main answering model (consultant reasoning) and effort (low|medium|high|xhigh|max)
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=medium
# Cheap background model for learning/memory extraction and history summaries
UTILITY_MODEL=claude-haiku-4-5
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex/proxies.
ENABLE_FALLBACKS=true

# Optional: Voyage AI key enables hybrid (semantic + keyword) retrieval
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Retrieval / token budget
TOP_K=8
MAX_CONTEXT_CHARS=14000
HISTORY_TURNS=6

# Server
PORT=3000
# Optional shared access token. If set, the UI asks for it once and sends it as a header.
APP_TOKEN=
DATA_DIR=./data
